{
  "model": "opus",
  "tui": "fullscreen",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.claude-tmp-creds/**)",
      "Bash(cat *.env*)",
      "Bash(sudo *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(bash <(curl *)",
      "Bash(sh <(curl *)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git commit *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/config.md)",
      "Read(**/config.json)",
      "Read(**/config.yaml)",
      "Read(**/config.yml)",
      "Read(~/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.npmrc)",
      "Read(~/.config/gh/**)",
    ]
  }
}
